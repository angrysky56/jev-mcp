# Copy to .env and fill in one provider's key. .env is gitignored; never commit a key.
#
# The MCP server (src/server.ts) reads its own process environment first and then
# loads this file for anything still unset, because a desktop MCP host launches the
# server without your shell's exports. Keys in ~/.bashrc or ~/.zshrc reach terminal
# sessions only, so a GUI-launched host needs this file (or an env block in its own
# MCP configuration).
#
# The experiment harness (npm run experiment) does NOT read this file. Export the key
# in the shell that launches it.

# Provider: openrouter (default) or typesafe.
JEV_PROVIDER=openrouter

# Default provider. Reports per-call cost.
OPENROUTER_API_KEY=

# Direct TypeSafe API. Returns the resolved model and token usage but no cost figure;
# runs count those calls under unreportedCosts.
# TYPESAFE_API_KEY=
